{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://ujcv-eats.onrender.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; connect-src 'self' https://ujcv-eats.onrender.com;"
        }
      ]
    }
  ]
}